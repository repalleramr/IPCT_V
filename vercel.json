{
  "functions": {

    "api/live.js": {

      "maxDuration": 30
    }
  },

  "headers": [

    {

      "source": "/api/(.*)",

      "headers": [

        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },

        {
          "key": "Cache-Control",
          "value": "no-store"
        }

      ]
    }
  ]
}
